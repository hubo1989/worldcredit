{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worldcredit",
  "compatibility_date": "2026-03-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "worldcredit",
      "database_id": "6ce5f678-e5bb-46cc-88d7-a316f1a209cb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "worldcredit-attachments"
    }
  ],
  "triggers": {
    "crons": [
      "0 9 * * *"
    ]
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "490117963106-31ss52gua36fa8i231ss074ed61rn330.apps.googleusercontent.com"
  }
}
